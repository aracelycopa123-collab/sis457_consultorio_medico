@model Sis457ConsultorioMedico.Models.Concepto

@{
    ViewData["Title"] = "Registrar Concepto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container position-relative pb-5" data-aos="fade-up" data-aos-delay="100">
    <div class="container section-title" data-aos="fade-up">
        <h2>Registrar Concepto</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="IdEspecialidad" class="form-label">Especialidad</label>
                                <select asp-for="IdEspecialidad" class="form-select" asp-items="ViewBag.IdEspecialidad">
                                    <option disabled selected value="0">Seleccione una especialidad</option>
                                </select>
                                <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Costo" class="form-label">Costo</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-dollar-sign"></i></span>
                                    <input asp-for="Costo" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Costo" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Descripcion" class="form-label">Descripción</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fa-solid fa-note-sticky"></i></span>
                                    <input asp-for="Descripcion" class="form-control" placeholder="Descripción del concepto" />
                                </div>
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk"></i> Guardar Concepto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
