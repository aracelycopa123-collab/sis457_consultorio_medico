@model Sis457ConsultorioMedico.Models.Concepto

@{
    ViewData["Title"] = "Detalles Concepto";
}

<style>
    .detail-card {
        background: #fff;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,.1);
        max-width: 700px;
        margin: 20px auto;
    }

        .detail-card h4 {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 20px;
        }

    .detail-row {
        display: flex;
        margin-bottom: 12px;
    }

        .detail-row dt {
            width: 180px;
            font-weight: 700;
            color: #2c3e50;
        }

        .detail-row dd {
            margin: 0;
            color: #333;
        }

    .detail-actions {
        margin-top: 20px;
        display: flex;
        gap: 10px;
    }

        .detail-actions a {
            text-decoration: none;
        }
</style>

<div class="detail-card">
    <h4>Detalles del Concepto</h4>
    <dl>
        <div class="detail-row">
            <dt>Descripción:</dt>
            <dd>@Model.Descripcion</dd>
        </div>
        <div class="detail-row">
            <dt>Costo:</dt>
            <dd>@Model.Costo.ToString("C")</dd>
        </div>
        <div class="detail-row">
            <dt>Especialidad:</dt>
            <dd>@Model.IdEspecialidadNavigation.Nombre</dd>
        </div>
        <div class="detail-row">
            <dt>Usuario Registro:</dt>
            <dd>@Model.UsuarioRegistro</dd>
        </div>
        <div class="detail-row">
            <dt>Fecha Registro:</dt>
            <dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
        </div>
        <div class="detail-row">
            <dt>Estado:</dt>
            <dd>@(Model.Estado == 1 ? "Activo" : "Inactivo")</dd>
        </div>
    </dl>

    <div class="detail-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
    </div>
</div>
