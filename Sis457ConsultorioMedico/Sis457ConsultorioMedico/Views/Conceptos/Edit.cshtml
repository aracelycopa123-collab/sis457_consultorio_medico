@model Sis457ConsultorioMedico.Models.Concepto

@{
    ViewData["Title"] = "Editar Concepto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container position-relative pb-5" data-aos="fade-up" data-aos-delay="100">
    <div class="container section-title" data-aos="fade-up">
        <h2>Editar Concepto</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm p-4">
                <h4 class="text-center mb-3">Datos del Concepto</h4>
                <hr />
                <form asp-action="Edit" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="IdEspecialidad" class="form-label">Especialidad</label>
                        <select asp-for="IdEspecialidad" class="form-control" asp-items="ViewBag.IdEspecialidad">
                            <option disabled selected value="0">Seleccione una especialidad</option>
                        </select>
                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Costo" class="form-label">Costo</label>
                        <input asp-for="Costo" class="form-control" />
                        <span asp-validation-for="Costo" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left"></i> Volver a la Lista
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
