@model IEnumerable<Sis457ConsultorioMedico.Models.Concepto>

@{
    ViewData["Title"] = "Conceptos";
}

<style>
    /* --- CONFIGURACIÓN GLOBAL PARA LISTAS --- */
    .list-container {
        background: #fff;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,.08);
    }

    .header-row div {
        font-weight: 700;
        color: #2c3e50;
    }

    .data-row:hover {
        background: #f6f8fa;
        transition: 0.2s;
    }

    .col-descripcion {
        width: 250px;
    }

    .col-costo {
        width: 120px;
    }

    .col-especialidad {
        width: 180px;
    }

    .col-acciones {
        width: 180px;
    }
</style>

<div class="container mt-4">

    <!-- TÍTULO + BOTÓN CREAR -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-primary m-0">Conceptos</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm px-3">
            <i class="bi bi-plus-circle"></i> Crear
        </a>
    </div>

    <div class="list-container">

        <!-- ENCABEZADOS -->
        <div class="d-flex border-bottom pb-2 mb-2 header-row text-uppercase small">
            <div class="col-descripcion">Descripción</div>
            <div class="col-costo">Costo</div>
            <div class="col-especialidad">Especialidad</div>
            <div class="col-acciones text-end">Acciones</div>
        </div>

        <!-- LISTADO -->
        @foreach (var item in Model)
        {
            <div class="d-flex align-items-center border-bottom py-3 data-row">
                <div class="col-descripcion">@item.Descripcion</div>
                <div class="col-costo">@item.Costo.ToString("C")</div>
                <div class="col-especialidad">
                    @item.IdEspecialidadNavigation.Nombre
                </div>
                <div class="col-acciones text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-1">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
