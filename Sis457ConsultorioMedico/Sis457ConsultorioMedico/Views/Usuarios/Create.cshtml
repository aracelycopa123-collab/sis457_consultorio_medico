@model Sis457ConsultorioMedico.Models.Usuario

@{
	ViewData["Title"] = "Crear Usuario";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container position-relative pb-5" data-aos="fade-up" data-aos-delay="100">
	<div class="container section-title" data-aos="fade-up">
		<h2>Crear Usuario</h2>
	</div>

	<p><strong>Doctor: </strong>@ViewBag.NombreDoctor</p>

	<form asp-action="Create" method="post">
		<input type="hidden" asp-for="IdDoctor" value="@ViewBag.IdDoctor" />

		<div class="form-group">
			<label class="control-label">Usuario</label>
			<input asp-for="Usuario1" class="form-control" />
			<span asp-validation-for="Usuario1" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label class="control-label">Contraseña</label>
			<input asp-for="Clave" type="password" class="form-control" />
			<span asp-validation-for="Clave" class="text-danger"></span>
		</div>

		<div class="form-group">
			<button type="submit" class="btn btn-primary">
				<i class="fa-solid fa-floppy-disk"></i> Guardar
			</button>
		</div>
	</form>

	<div>
		<a asp-controller="Doctores" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Volver a la lista</a>
	</div>
</div>

