@model IEnumerable<Sis457ConsultorioMedico.Models.Especialidad>

@{
    ViewData["Title"] = "Especialidades";
}

<style>
    .list-container {
        background: #fff;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,.08);
    }

    .header-row div {
        font-weight: 700;
        color: #2c3e50;
    }

    .data-row:hover {
        background: #f6f8fa;
        transition: 0.2s;
    }

    /* Columnas compactas */
    .col-nombre {
        flex: 0 0 280px;
    }

    .col-estado {
        flex: 0 0 120px;
    }

    .col-acciones {
        flex: 0 0 240px;
        text-align: end;
    }

    .header-row, .data-row {
        display: flex;
        align-items: center;
    }
</style>

<div class="container mt-4">

    <!-- Título y botón -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-primary m-0">Especialidades</h1>

        <a asp-action="Create" class="btn btn-success shadow-sm px-3">
            <i class="bi bi-plus-circle"></i> Registrar
        </a>
    </div>

    <div class="list-container">

        <!-- Encabezados -->
        <div class="header-row border-bottom pb-2 mb-2 text-uppercase small">
            <div class="col-nombre">Nombre</div>
            <div class="col-estado">Estado</div>
            <div class="col-acciones">Acciones</div>
        </div>

        <!-- Lista -->
        @foreach (var item in Model)
        {
            <div class="data-row border-bottom py-3">

                <div class="col-nombre">@item.Nombre</div>

                <div class="col-estado">
                    <span class="badge @(item.Estado == 1 ? "bg-success" : "bg-danger")">
                        @(item.Estado == 1 ? "Activo" : "Inactivo")
                    </span>
                </div>

                <div class="col-acciones">

                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-outline-secondary btn-sm me-1">
                        <i class="bi bi-eye"></i>
                    </a>

                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-outline-primary btn-sm me-1">
                        <i class="bi bi-pencil"></i>
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i>
                    </a>

                </div>
            </div>
        }
    </div>
</div>
