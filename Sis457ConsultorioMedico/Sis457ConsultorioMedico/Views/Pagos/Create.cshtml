@model Sis457ConsultorioMedico.Models.Pago

@{
	ViewData["Title"] = "Registar Pago";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container position-relative pb-5" data-aos="fade-up" data-aos-delay="100">
	<div class="container section-title" data-aos="fade-up">
		<h2>Registrar Pago</h2>
	</div>
	<div class="row">
		<div class="col-md-4">
			<form asp-action="Create">
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>
				<div class="mb-3">
					<strong>Paciente:</strong> @ViewBag.NombrePaciente
				</div>
				<div class="mb-3">
					<strong>Especialidad:</strong> @ViewBag.NombreEspecialidad
				</div>
				<div class="form-group">
					<input type="hidden" asp-for="IdCita" />
				</div>
				<div class="form-group">
					<label class="control-label">Concepto de Pago</label>
					<select asp-for="IdConcepto" class="form-control" asp-items="ViewBag.IdConcepto">
						<option disabled selected value="0">Seleccione un Concepto de Pago</option>
					</select>
					<span asp-validation-for="IdConcepto" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label>Costo:</label>
					<input type="text" id="costo" class="form-control" readonly />
				</div>
				<div class="form-group">
					<label asp-for="Efectivo" class="control-label"></label>
					<input asp-for="Efectivo" class="form-control" id="montoPagado" />
					<span asp-validation-for="Efectivo" class="text-danger"></span>
				</div>
				<div class="form-group">
					<label>Cambio:</label>
					<input type="text" id="cambio" class="form-control" readonly />
				</div>
				<div class="form-group">
					<button type="submit" class="btn btn-primary">
						<i class="fa-solid fa-floppy-disk"></i> Agendar
					</button>
				</div>
			</form>
		</div>
	</div>
	<div class="col-md-4">
		<a asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Volver a la lista</a>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		// Diccionario con los costos según el concepto
		const costos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CostosConceptos));

		const conceptoSelect = document.getElementById("IdConcepto");
		const costoInput = document.getElementById("costo");
		const montoInput = document.getElementById("montoPagado");
		const cambioInput = document.getElementById("cambio");

		function actualizarCostoYCalculo() {
			const conceptoId = conceptoSelect.value;
			const costo = parseFloat(costos[conceptoId]) || 0;
			const pagado = parseFloat(montoInput.value) || 0;

			costoInput.value = costo.toFixed(2);
			const cambio = pagado - costo;
			cambioInput.value = cambio >= 0 ? cambio.toFixed(2) : "0.00";
		}

		conceptoSelect.addEventListener("change", actualizarCostoYCalculo);
		montoInput.addEventListener("input", actualizarCostoYCalculo);

		// Inicializar valores cuando carga la página
		actualizarCostoYCalculo();
	</script>
	}
