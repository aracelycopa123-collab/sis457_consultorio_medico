@model Sis457ConsultorioMedico.Models.Doctor

@{
    ViewData["Title"] = "Eliminar Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="text-center p-5 shadow rounded" style="max-width: 550px; background-color: #fff;">
        <h2 class="text-danger mb-3"><i class="fa-solid fa-triangle-exclamation"></i> ¡Atención!</h2>
        <p class="mb-4">Estás a punto de eliminar al doctor <strong>@Model.Nombres @Model.PrimerApellido @Model.SegundoApellido</strong>.</p>
        <p class="text-muted">Esta acción no se puede deshacer.</p>

        <div class="text-start mb-4">
            <dl class="row">
                <dt class="col-sm-5">Cédula de Identidad</dt>
                <dd class="col-sm-7">@Model.CedulaIdentidad</dd>

                <dt class="col-sm-5">Especialidad</dt>
                <dd class="col-sm-7">@Model.IdEspecialidadNavigation?.Nombre</dd>

                <dt class="col-sm-5">Dirección</dt>
                <dd class="col-sm-7">@Model.Direccion</dd>

                <dt class="col-sm-5">Celular</dt>
                <dd class="col-sm-7">@Model.Celular</dd>

                <dt class="col-sm-5">Usuario Registro</dt>
                <dd class="col-sm-7">@Model.UsuarioRegistro</dd>

                <dt class="col-sm-5">Fecha de Registro</dt>
                <dd class="col-sm-7">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-5">Estado</dt>
                <dd class="col-sm-7">@(Model.Estado == 1 ? "Activo" : "Inactivo")</dd>
            </dl>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary w-45">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger w-45">
                    <i class="fa-solid fa-trash"></i> Eliminar
                </button>
            </div>
        </form>
    </div>
</div>
