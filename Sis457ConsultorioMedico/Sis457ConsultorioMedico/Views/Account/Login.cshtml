@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="col-md-5">

        <div class="card shadow-sm border-0 p-4 rounded-4" style="backdrop-filter: blur(6px); background: rgba(255,255,255,0.85);">

            <h3 class="text-center mb-4 fw-bold" style="color:#0d6efd;">Iniciar Sesión</h3>

            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">

                <!-- Errores -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Usuario -->
                <div class="mb-3">
                    <label asp-for="usuario" class="form-label fw-semibold"></label>
                    <input asp-for="usuario"
                           class="form-control form-control-lg"
                           placeholder="Usuario"
                           required />
                    <span asp-validation-for="usuario" class="text-danger"></span>
                </div>

                <!-- Contraseña -->
                <div class="mb-3">
                    <label asp-for="clave" class="form-label fw-semibold"></label>
                    <input asp-for="clave"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="Contraseña"
                           required />
                    <span asp-validation-for="clave" class="text-danger"></span>
                </div>

                <!-- Recordarme -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input type="checkbox" id="recordarme" name="recordarme" class="form-check-input" />
                        <label for="recordarme" class="form-check-label">Recordarme</label>
                    </div>

                    <a asp-controller="Account" asp-action="ResetPassword" class="text-decoration-none">
                        ¿Se te olvidó la contraseña?
                    </a>
                </div>

                <!-- Botón -->
                <button type="submit" class="btn btn-primary w-100 btn-lg rounded-3">
                    Iniciar Sesión
                </button>

            </form>

        </div>
    </div>
</div>

<style>
    body {
        background: url('https://img.freepik.com/foto-gratis/vista-lateral-doctora-estetoscopio_23-2148453476.jpg?semt=ais_hybrid&w=740&q=80') no-repeat center center fixed !important;
        background-size: cover !important;
    }

    .card {
        border-radius: 16px;
    }

    .form-control-lg {
        border-radius: 10px;
        padding: 12px 14px;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 6px rgba(13, 110, 253, 0.4);
    }
</style>
