@model Sis457ConsultorioMedico.Models.Paciente

@{
	ViewData["Title"] = "Registrar Paciente";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container position-relative pb-5" data-aos="fade-up" data-aos-delay="100">
	<div class="container section-title" data-aos="fade-up">
		<h2>Registrar Paciente</h2>
	</div>

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm">
				<div class="card-body">
					<form asp-action="Create" method="post" novalidate>
						@Html.AntiForgeryToken()
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

						<div class="row g-3">
							<div class="col-md-6">
								<label asp-for="CedulaIdentidad" class="form-label">Cédula Identidad</label>
								<div class="input-group">
									<span class="input-group-text"><i class="fa-solid fa-id-card"></i></span>
									<input asp-for="CedulaIdentidad" class="form-control" placeholder="Ej. 1234567" autocomplete="off" />
								</div>
								<span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label asp-for="Celular" class="form-label">Celular</label>
								<div class="input-group">
									<span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
									<input asp-for="Celular" class="form-control" placeholder="Ej. 71234567" />
								</div>
								<span asp-validation-for="Celular" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label asp-for="Nombres" class="form-label">Nombres</label>
								<input asp-for="Nombres" class="form-control" placeholder="Nombres" />
								<span asp-validation-for="Nombres" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label asp-for="PrimerApellido" class="form-label">Apellido Paterno</label>
								<input asp-for="PrimerApellido" class="form-control" placeholder="Apellido paterno" />
								<span asp-validation-for="PrimerApellido" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label asp-for="SegundoApellido" class="form-label">Apellido Materno</label>
								<input asp-for="SegundoApellido" class="form-control" placeholder="Apellido materno" />
								<span asp-validation-for="SegundoApellido" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
								<input asp-for="FechaNacimiento" class="form-control" type="date" id="FechaNacimiento" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
								<span asp-validation-for="FechaNacimiento" class="text-danger"></span>
							</div>

							<div class="col-md-6">
								<label class="form-label">Edad</label>
								<input type="text" id="Edad" class="form-control" readonly placeholder="-- años" />
							</div>

							<div class="col-12">
								<label asp-for="Direccion" class="form-label">Dirección (opcional)</label>
								<input asp-for="Direccion" class="form-control" placeholder="Calle, número, zona" />
								<span asp-validation-for="Direccion" class="text-danger"></span>
							</div>
						</div>

						<div class="mt-4 d-flex justify-content-between align-items-center">
							<div>
								<a asp-action="Index" class="btn btn-secondary">
									<i class="fa-solid fa-arrow-left"></i> Volver a la lista
								</a>
							</div>
							<div>
								<button type="submit" class="btn btn-primary btn-lg">
									<i class="fa-solid fa-floppy-disk"></i> Registrar
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

	<script>
		(function () {
			const fechaInput = document.getElementById('FechaNacimiento');
			const edadInput = document.getElementById('Edad');

			function calcularEdad(fecha) {
				if (!fecha) return '';
				const hoy = new Date();
				const nacimiento = new Date(fecha);
				let edad = hoy.getFullYear() - nacimiento.getFullYear();
				const m = hoy.getMonth() - nacimiento.getMonth();
				if (m < 0 || (m === 0 && hoy.getDate() < nacimiento.getDate())) {
					edad--;
				}
				return isNaN(edad) ? '' : edad + ' años';
			}

			function actualizarEdad() {
				const val = fechaInput.value;
				edadInput.value = calcularEdad(val);
			}

			if (fechaInput) {
				fechaInput.addEventListener('change', actualizarEdad);
				fechaInput.addEventListener('blur', actualizarEdad);
				// inicializar
				actualizarEdad();
			}
		})();
	</script>
}
