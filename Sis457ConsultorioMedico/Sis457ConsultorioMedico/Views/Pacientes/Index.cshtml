@model IEnumerable<Sis457ConsultorioMedico.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";

    bool todosActivos = Model.All(x => x.Estado == 1);

    int CalcularEdad(DateTime? fecha)
    {
        if (fecha == null) return 0;

        var hoy = DateTime.Today;
        int edad = hoy.Year - fecha.Value.Year;
        if (fecha.Value.Date > hoy.AddYears(-edad)) edad--;
        return edad;
    }
}

<style>
    /* --- CONFIGURACIÓN GLOBAL PARA TODAS LAS LISTAS --- */

    .list-container {
        background: #fff;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 6px 14px rgba(0,0,0,.10);
    }

    /* --- CONTENIDO MÁS ANCHO Y TIPOGRAFÍA MÁS GRANDE --- */
    .data-row div,
    .header-row div {
        font-size: 17px;
    }

    .header-row {
        padding-bottom: 12px;
        margin-bottom: 10px;
    }

        .header-row div {
            font-weight: 700;
            color: #2c3e50;
            letter-spacing: .5px;
        }

    .data-row {
        padding: 18px 0;
    }

        .data-row:hover {
            background: #f4f7fb;
            transition: 0.2s;
        }

    /* --- ANCHO DE COLUMNAS MÁS AMPLIO --- */
    .col-ci {
        width: 140px;
    }

    .col-nombre {
        width: 200px;
    }

    .col-app {
        width: 200px;
    }

    .col-apm {
        width: 200px;
    }

    .col-edad {
        width: 110px;
    }

    .col-direccion {
        width: 260px;
    }

    .col-celular {
        width: 150px;
    }

    .col-estado {
        width: 120px;
    }

    .col-acciones {
        width: 200px;
    }

</style>

<div class="container-fluid px-5 mt-4">

    <!-- TITULO Y BOTÓN CREAR -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 fw-bold text-primary m-0">Pacientes</h1>

        <a asp-action="Create" class="btn btn-success shadow-sm px-4 py-2">
            <i class="bi bi-plus-circle"></i> Registrar
        </a>
    </div>

    <div class="list-container">

        <!-- BUSCADOR -->
        <form asp-action="Index" method="get" class="input-group mb-4">
            <input type="text" name="buscar" class="form-control form-control-lg"
                   placeholder="Buscar por nombre, CI o apellido…">
            <button class="btn btn-primary btn-lg px-4">
                <i class="bi bi-search"></i>
            </button>
        </form>

        <!-- ENCABEZADOS -->
        <div class="d-flex border-bottom header-row text-uppercase small">

            <div class="col-ci">C.I.</div>
            <div class="col-nombre">Nombres</div>
            <div class="col-app">Ap. Paterno</div>
            <div class="col-apm">Ap. Materno</div>
            <div class="col-edad">Edad</div>
            <div class="col-direccion">Dirección</div>
            <div class="col-celular">Celular</div>

            @if (!todosActivos)
            {
                <div class="col-estado">Estado</div>
            }

            <div class="col-acciones text-end">Acciones</div>
        </div>

        <!-- LISTADO -->
        @foreach (var p in Model)
        {
            <div class="d-flex align-items-center border-bottom data-row">

                <div class="col-ci">@p.CedulaIdentidad</div>
                <div class="col-nombre">@p.Nombres</div>
                <div class="col-app">@p.PrimerApellido</div>
                <div class="col-apm">@p.SegundoApellido</div>
                <div class="col-edad">@CalcularEdad(p.FechaNacimiento) años</div>
                <div class="col-direccion">@p.Direccion</div>
                <div class="col-celular">@p.Celular</div>

                @if (!todosActivos)
                {
                    <div class="col-estado">
                        <span class="badge @(p.Estado == 1 ? "bg-success" : "bg-danger")">
                            @(p.Estado == 1 ? "Activo" : "Inactivo")
                        </span>
                    </div>
                }

                <div class="col-acciones text-end">

                    <a asp-action="Details" asp-route-id="@p.Id"
                       class="btn btn-outline-secondary btn-sm me-1 px-3 py-1">
                        <i class="bi bi-eye"></i>
                    </a>

                    <a asp-action="Edit" asp-route-id="@p.Id"
                       class="btn btn-outline-primary btn-sm me-1 px-3 py-1">
                        <i class="bi bi-pencil"></i>
                    </a>

                    <form asp-action="Delete" asp-route-id="@p.Id"
                          method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-1"
                                onclick="return confirm('¿Eliminar este paciente?');">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>

                </div>
            </div>
        }
    </div>
</div>
