@model IEnumerable<Sis457ConsultorioMedico.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";

    // Verificar si todos son activos
    bool todosActivos = Model.All(x => x.Estado == 1);

    // Función para calcular edad
    int CalcularEdad(DateTime? fecha)
    {
        if (fecha == null) return 0;

        var hoy = DateTime.Today;
        int edad = hoy.Year - fecha.Value.Year;

        if (fecha.Value.Date > hoy.AddYears(-edad)) edad--;

        return edad;
    }
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-primary">Lista de Pacientes</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus"></i> Registrar Nuevo
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>C.I.</th>
                        <th>Nombres</th>
                        <th>Apellido Paterno</th>
                        <th>Apellido Materno</th>
                        <th>Fecha Nac.</th>
                        <th>Edad</th>
                        <th>Dirección</th>
                        <th>Celular</th>
                        <th>Usuario Registro</th>
                        <th>Fecha Registro</th>

                        @* Si NO todos son activos, mostrar Estado *@
                        @if (!todosActivos)
                        {
                            <th>Estado</th>
                        }

                        <th style="width: 170px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.CedulaIdentidad</td>
                            <td>@p.Nombres</td>
                            <td>@p.PrimerApellido</td>
                            <td>@p.SegundoApellido</td>

                            <td>@(p.FechaNacimiento?.ToString("dd/MM/yyyy"))</td>

                            <td><strong>@CalcularEdad(p.FechaNacimiento)</strong> años</td>

                            <td>@p.Direccion</td>
                            <td>@p.Celular</td>
                            <td>@p.UsuarioRegistro</td>
                            <td>@p.FechaRegistro.ToString("dd/MM/yyyy")</td>

                            @if (!todosActivos)
                            {
                                <td>
                                    @if (p.Estado == 1)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                            }

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Eliminar este paciente?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
