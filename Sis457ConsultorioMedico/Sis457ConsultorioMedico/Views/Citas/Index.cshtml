@model IEnumerable<Sis457ConsultorioMedico.Models.Cita>

@{
	ViewData["Title"] = "Citas";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid" data-aos="fade-up" data-aos-delay="100">
	<div class="container section-title" data-aos="fade-up">
		<h2>Citas</h2>
	</div>
	<p>
		<a asp-action="Create"><i class="fa-solid fa-file-circle-plus"></i> Nueva Cita</a>
	</p>
	<table class="table">
		<thead>
			<tr>
				<th>Fecha</th>
				<th>Hora</th>
				<th>Paciente</th>
				<th>Especialidad</th>
				<th>Doctor</th>
				<th>Pagado</th>
				<th>Fecha de Pago</th>
				<th>Usuario Registro</th>
				<th>Fecha Registro</th>
				<th>Estado</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Fecha)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Hora)
					</td>
					<td>
						@(item.IdPacienteNavigation.Nombres + " " + item.IdPacienteNavigation.PrimerApellido + " " + item.IdPacienteNavigation.SegundoApellido)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.IdEspecialidadNavigation.Nombre)
					</td>
					<td>
						@(item.IdDoctorNavigation.Nombres + " " + item.IdDoctorNavigation.PrimerApellido + " " + item.IdDoctorNavigation.SegundoApellido)
					</td>
					<td>
						@(item.Pagos != null && item.Pagos.Any() ? "Sí" : "No")
					</td>
					<td>
						@(item.Pagos.FirstOrDefault()?.Fecha.ToString("dd/MM/yyyy") ?? "--")
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.UsuarioRegistro)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.FechaRegistro)
					</td>
					<td>
						@(item.Estado == 1 ? "Activo" : "Inactivo")
					</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.Id"><i class="fa-solid fa-money-bill-1-wave"></i></a> |
						<a asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-file-pen"></i></a> |
						<a asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash-can"></i></a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
